// Charts of the statistics panel, drawn with d3 into the given <svg> element (a plain DOM element).

function createHeatmap(el, data, type) {
  var selectedDate = el.parentElement.getAttribute('data-date');

  var years = d3.nest()
      .key(function(d) { return d.date.getUTCFullYear(); })
    .entries(data)
    .reverse();

  var cellSize = 13;
  var weekday = "sunday";
  var height = cellSize * (weekday === "weekday" ? 7 : 9)
  var timeWeek = weekday === "sunday" ? d3.utcSunday : d3.utcMonday
  var countDay = weekday === "sunday" ? function(d) { return d.getUTCDay(); } : function(d) { (d.getUTCDay() + 6) % 7; };

  function pathMonth(t) {
    var n = weekday === "weekday" ? 5 : 7;
    var d = Math.max(0, Math.min(n, countDay(t)));
    var w = timeWeek.count(d3.utcYear(t), t);
    if ( d === 0 ) {
      return 'M' + w * cellSize + ',0V' + n * cellSize;
    } else if ( d === n ) {
      return 'M' + (w + 1) * cellSize + ',0V' + n * cellSize;
    } else {
      return 'M' + (w + 1) * cellSize + ',0V' + d * cellSize + 'H' + w * cellSize + 'V' + n * cellSize;
    }
  }

  var formatDate = d3.utcFormat("%d.%m.%Y");

  var formatDay = function(d) { return "SMTWTFS"[d.getUTCDay()]; };

  var formatMonth = d3.utcFormat("%b");

  var formatTooltip = d3.utcFormat('%A %B %d, %Y');

  var color = d3.scaleLinear()
    .domain([0, 1, 25])
    .range(['#EEEEEE', '#CCCCFF', '#007bff'])
    .interpolate(d3.interpolateRgb);

  var svg = d3.select(el);
  el.style.fontSize = '12px';
  el.style.width = cellSize * 53 + 50 + 'px';
  el.style.height = height + 'px';

  var year = svg.selectAll("g")
    .data(years)
    .join("g")
      .attr("transform", function(d, i) { return 'translate(40,' + height * i + cellSize * 1.5 +')'; });

  year.append("text")
      .attr("x", -5)
      .attr("y", -6)
      .attr("font-weight", "bold")
      .attr("text-anchor", "end")
      .attr("fill", "#fff")
      .text(function(d) { return d.key; });

  year.append("g")
      .attr("text-anchor", "end")
    .selectAll("text")
    .data((weekday === "weekday" ? d3.range(2, 7) : d3.range(7)).map(function(i) { return new Date(1995, 0, i);}))
    .join("text")
      .attr("x", -5)
      .attr("y", function(d) { return (countDay(d) + 0.5) * cellSize; })
      .attr("fill", "#fff")
      .text(formatDay);

  var tooltip = document.getElementById('chartTooltip');
  if ( ! tooltip ) {
    tooltip = document.createElement('div');
    tooltip.id = 'chartTooltip';
    tooltip.style.height = '46px';
    tooltip.style.opacity = '0';
    el.parentElement.appendChild(tooltip);
  }

  var dateEl = null;

  year.append("g")
    .selectAll("rect")
    .data(function(d) { return d.values; })
    .join("rect")
      .attr("width", cellSize - 1)
      .attr("height", cellSize - 1)
      .attr("x", function(d) { return timeWeek.count(d3.utcYear(d.date), d.date) * cellSize + 0.5; })
      .attr("y", function(d) { return countDay(d.date) * cellSize + 0.5; })
      .attr("fill", function(d) {
        if ( d.selector == selectedDate ) {
          dateEl = this;
          return 'red';
        } else {
          return color(d.value);
        }
      })
      .attr('stroke', 'black')
      .attr('stroke-opacity', '0')
    .on("mouseover", function(d) {
      this.setAttribute('stroke-opacity', '0.8');
      var textHelper = d.value == 1 ? ' document on ' : ' documents on ';
      tooltip.innerHTML = d.value + textHelper + formatTooltip(d.date);
      tooltip.style.opacity = '0.9';
      tooltip.style.left = (d3.event.pageX - 60) + "px";
      tooltip.style.top = (d3.event.pageY - 50 + document.getElementById('stats_chart').scrollTop) + "px";
    })
    .on("mouseout", function(d) {
      this.setAttribute('stroke-opacity', '0');
      tooltip.style.opacity = '0';
    })
    .on("click", function(d) {
      var element = el.parentElement;
      if ( element.classList.contains('activeFilter') ) {
        var existingDate = new Date(element.getAttribute('data-date'));
        if ( new Date(d.selector).getTime() == existingDate.getTime() ) {
          element.classList.remove('activeFilter');
          element.removeAttribute('data-type');
          element.removeAttribute('data-date');
          this.setAttribute("fill", color(d.value));
          dateEl = null;
        } else {
          if ( !! dateEl ) {
            dateEl.setAttribute('fill', color(d.value));
          }
          element.setAttribute('data-date', d.selector);
          dateEl = this;
          this.setAttribute('fill', 'red');
        }
      } else {
        element.classList.add('activeFilter');
        element.setAttribute('data-type', type);
        element.setAttribute('data-date', d.selector);
        this.setAttribute('fill', 'red');
        dateEl = this;
      }
      kleissner.frontendChanges.onToggleFilter();
    });

  var month = year.append("g")
    .selectAll("g")
    .data(function(d) {
      return d3.utcMonths(d3.utcMonth(new Date(d.values[0].date.getUTCFullYear(), 1, 1)), new Date(d.values[d.values.length - 1].date.getUTCFullYear(), 12, 1));
    })
    .join("g");

  month.filter(function(d, i) { return i; }).append("path")
      .attr("fill", "none")
      .attr("stroke", "#000")
      .attr("stroke-width", 2)
      .attr("d", pathMonth);

  month.append("text")
      .attr("x", function(d) { return timeWeek.count(d3.utcYear(d), timeWeek.ceil(d)) * cellSize + 2; })
      .attr("y", -5)
      .attr("fill", "#fff")
      .text(formatMonth);
}

function createPieChart(el, data, type, width) {
  var total = 0;
  for ( var i = 0; i < data.length; i++ ) {
    total += data[i].value;
  }

  var width = width;

  var pie = d3.pie()
    .sort(null)
    .value(function(d) { return d.value; });

  var arc = d3.arc().innerRadius(0).outerRadius(width / 2 - 1);

  var radius = width / 2 * 0.8;
  var arcLabel = d3.arc().innerRadius(radius).outerRadius(radius);

  var color = d3.scaleOrdinal()
    .domain(data.map(function(d) { return d.name; }))
    .range(d3.quantize(function(t) { return d3.interpolateSpectral(t * 0.8 + 0.1); }, data.length).reverse());

  var arcs = pie(data);

  var svg = d3.select(el)
    .attr("text-anchor", "middle");

  el.style.fontSize = '12px';
  el.style.width = width + 'px';
  el.style.height = width + 'px';

  var g = svg.append("g")
    .attr("transform", 'translate(' + width / 2 + ', ' + width / 2 + ')');

  g.selectAll("path")
    .data(arcs)
    .enter().append("path")
      .attr("fill", function(d) { return color(d.data.name); })
      .attr("d", arc);

  var text = g.selectAll("text")
    .data(arcs)
    .enter().append("text")
      .attr("transform", function(d) { return 'translate(' + arcLabel.centroid(d) + ')'; })
      .attr("dy", "0.35em");

  /*text.append("tspan")
    .attr("x", 0)
    .attr("y", "-0.7em")
    .style("font-weight", "bold")
    .text(function(d) { return d.data.name; });

  text.append("tspan")
    .attr("x", 0)
    .attr("y", "0.7em")
    .attr("fill-opacity", 0.7)
    .text(function(d) {
      return Math.round(d.data.value/total * 10000) / 100 + '%';
    });*/

  el.parentElement.appendChild(createLegend(data, type, color, total));
}

// createLegend builds the legend of a pie chart; web.* sources are listed under their own "Web:" title.
function createLegend(data, type, color, total)
{
  var legendDiv = elementFromHTML('<div class="chartLegend" style="display:flex;flex-direction:column;justify-content:center;font-size:14px;padding:0;margin-left: 20px;"></div>');
  var legendDivWebTitle = elementFromHTML('<h6 style="font-size: 1em; font-weight: normal; margin: 1em 0.1em 0.1em 0.1em">Web:</h6>');
  var legendDivWeb = document.createElement('div');
  for ( var i = 0; i < data.length; i++ ) {
    if (typeof data[i].selector === 'string' && data[i].selector.substr(0, 4) === 'web.') {
      data[i].name = data[i].name.substr(6);
      legendDivWeb.appendChild(createLegendRow(data[i], type, color, total));
    } else {
      legendDiv.appendChild(createLegendRow(data[i], type, color, total));
    }
  }
  if (legendDivWeb.children.length) {
    legendDiv.appendChild(legendDivWebTitle);
    legendDiv.appendChild(legendDivWeb);
  }
  return legendDiv;
}

function createLegendRow(dataRow, type, color, total)
{
  var classFilter = dataRow.filter == true ? ' activeFilter' : '';
  var legendDivRow = elementFromHTML('<div class="legendRow'+classFilter+'" data-type="' + type + '" data-value="' + dataRow.selector + '"><div style="display: inline-block;width: 10px; height: 10px; margin-right: 10px; background-color: ' + color(dataRow.name) + '"></div>' + dataRow.name + ': ' + dataRow.value + ' (' + Math.round(dataRow.value/total * 10000) / 100 + '%)' + '</div>');
  legendDivRow.addEventListener('click', kleissner.frontendChanges.onToggleFilter);
  return legendDivRow;
}
