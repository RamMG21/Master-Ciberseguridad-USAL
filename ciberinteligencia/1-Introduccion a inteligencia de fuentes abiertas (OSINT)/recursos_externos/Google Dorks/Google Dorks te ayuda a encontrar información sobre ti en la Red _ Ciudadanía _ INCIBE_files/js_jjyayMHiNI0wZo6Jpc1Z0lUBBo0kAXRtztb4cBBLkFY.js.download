(function($,Drupal){Drupal.behaviors.linkifyCVE={attach:function(context,settings){$('.paragraph--type--paragraph-cve .field--name-field-identificador-cve .field__item',context).each(function(){var $item=$(this);if($item.data('processed-cve-link'))return;if($item.find('a').length>0){$item.data('processed-cve-link',true);return;}var rawText=$item.text().trim();var cve=rawText.toUpperCase();if(/^CVE-\d{4}-\d{4,7}$/.test(cve)){var url='/incibe-cert/alerta-temprana/vulnerabilidades/'+cve;$item.html('<a href="'+url+'" target="_blank" rel="noopener noreferrer">'+cve+'</a>');}$item.data('processed-cve-link',true);});}};})(jQuery,Drupal);(function($){Drupal.behaviors.cveTableBuilder={attach:function(context,settings){if($('.cve-global-table').length>0)return;const rows=[];$('.paragraph--type--paragraph-cve',context).each(function(){const $paragraph=$(this);const cve=$paragraph.find('.field--name-field-identificador-cve .field__item').text().trim()||$paragraph.find('.field--name-field-identifica-cve .field__item').text().trim();const severidad=$paragraph.find('.field--name-field-severidad .field__item').text().trim();const explotacion=$paragraph.find('.field--name-field-explotacion .field__item').text().trim();const fabricante1=$paragraph.find('.field--name-field-fabricante .field__item').text().trim();const fabricante2=$paragraph.find('.field--name-field-nuevo-fabricante .field__item').text().trim();const fabricanteFinal=[fabricante1,fabricante2].filter(Boolean).map((f)=>f.toUpperCase()).join(', ');if(cve)rows.push(`
            <tr>
              <td><a href="/incibe-cert/alerta-temprana/vulnerabilidades/${cve}" target="_blank" rel="noopener noreferrer">${cve}</a></td>
              <td>${severidad}</td>
              <td>${explotacion}</td>
              <td>${fabricanteFinal}</td>
            </tr>
          `);});if(rows.length>0){const tableHtml=`
          <table class="cve-global-table">
            <thead>
              <tr>
                <th>Identificador CVE</th>
                <th>Severidad</th>
                <th>Explotación</th>
                <th>Fabricante</th>
              </tr>
            </thead>
            <tbody>
              ${rows.join('')}
            </tbody>
          </table>
          <p class="cve-note">
            <strong>Nota:</strong> El valor de explotación de cada vulnerabilidad corresponde al momento de publicación de este aviso. Dicho valor puede haber cambiado en el trascurso del tiempo.
          </p>
        `;$('.paragraph--type--paragraph-cve',context).first().before(tableHtml);}$('.paragraph--type--paragraph-cve',context).hide();}};})(jQuery);(function($,Drupal){Drupal.behaviors.cveTableBuilderNew={attach:function(context,settings){function processTableField(){$('.tablefield',context).each(function(){const $table=$(this);if($table.data('cve-built'))return;let hasVisibleRows=false;$table.find('tbody tr').each(function(){const $row=$(this);const $cveCell=$row.find('td.col_0');const $severidadCell=$row.find('td.col_1');const $explotacionCell=$row.find('td.col_2');const $fabricanteCell=$row.find('td.col_3');const cve=$cveCell.text().trim().toUpperCase();const fabricante=$fabricanteCell.text().trim();if(cve&&/^CVE-\d{4}-\d{4,7}$/.test(cve))if($cveCell.find('a').length===0)$cveCell.html('<a href="/incibe-cert/alerta-temprana/vulnerabilidades/'+cve+'" target="_blank" rel="noopener noreferrer">'+cve+'</a>');if(fabricante)$fabricanteCell.text(fabricante.toUpperCase());if(!cve)$row.hide();else{$row.show();hasVisibleRows=true;}});const $fieldContainer=$table.closest('.field--name-field-cve-table');if(hasVisibleRows)$fieldContainer.show();else $fieldContainer.hide();if($table.next('.cve-note').length===0)$table.after('<p class="cve-note">'+'<strong>Nota:</strong> El valor de explotación de cada vulnerabilidad corresponde al momento de publicación de este aviso. '+'Dicho valor puede haber cambiado en el transcurso del tiempo.'+'</p>');$table.data('cve-built',true);});}processTableField();const observer=new MutationObserver(processTableField);observer.observe(document.body,{childList:true,subtree:true});}};})(jQuery,Drupal);;
window.addEventListener("load",reloadCaptcha);function reloadCaptcha(){if(document.getElementsByClassName("captcha-type-challenge--recaptcha").length!=0)if(!document.getElementById("g-recaptcha-response")&&document.getElementsByClassName("cookies-fallback").length==0)drupalRecaptchaOnload();};
